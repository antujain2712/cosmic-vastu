# Copy to .env.local and fill in. Everything is optional: without keys the site runs in demo mode.

# AI (https://console.anthropic.com) — room detection, written reports, chat assistant
ANTHROPIC_API_KEY=

# Payments (https://dashboard.razorpay.com) — UPI, cards, international cards
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret for event payment.captured → https://YOUR-DOMAIN/api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# Emails (https://resend.com) — booking confirmations and report links
RESEND_API_KEY=
EMAIL_FROM="Cosmic Vastu Culture <bookings@your-domain.com>"
ADMIN_EMAIL=cosmicculture@gmail.com

# Studio dashboard at /admin (in production: at least 10 characters, not change-me)
ADMIN_PASSWORD=change-me

# Private preview only: show the test checkout on the live site while Razorpay is pending.
# Anyone with the link can then unlock reports for free — turn off before sharing publicly.
ALLOW_TEST_PAYMENTS=false

# Public URL, used in emails
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local storage: the JSON database and uploads live in DATA_DIR (default ./data)
# DATA_DIR=

# Vercel storage. Connecting the stores in the Vercel dashboard fills these in automatically;
# when they are set, data goes to Redis and uploads to Blob instead of DATA_DIR.
# Upstash Redis (Vercel Marketplace):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# Vercel Blob (create the store as Private):
# BLOB_READ_WRITE_TOKEN=
